# Documentation only: Spring Boot does not automatically load this file.
# Set these variables in PowerShell or IntelliJ's run configuration.
JWT_SECRET=<Base64-of-at-least-32-cryptographically-random-bytes>
TRACKING_SECRET=<Base64-of-exactly-32-random-bytes-independent-of-JWT>
TRACKING_LINK_URL=http://localhost:4200/track-order
ORDER_MAIL_JOB_ENABLED=true
JWT_ISSUER=tireshop
JWT_AUDIENCE=tireshop-api
JWT_ACCESS_TOKEN_TTL=15m
CORS_ALLOWED_ORIGINS=http://localhost:4200
SERVER_PORT=8080
# Optional bootstrap: use your own email/password; disable after first creation.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
